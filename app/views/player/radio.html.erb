<div class="max-w-4xl" 
     data-controller="audio-player" 
     data-audio-player-shuffle-value="true"
     data-audio-player-songs-value="<%= @songs_json %>">
  
  <div class="bg-white">
    <h1 class="text-3xl font-bold text-red-800 mb-6 text-left">📻 Radio Drame</h1>
    
    <div class="flex gap-4 justify-start mb-3">
      <button data-action="click->audio-player#previous"
              class="bg-red-600 hover:bg-red-700 text-white font-medium px-6 py-3 transition">
        ⏮ Morceau précédent
      </button>
      <button data-action="click->audio-player#next"
              class="bg-red-600 hover:bg-red-700 text-white font-medium px-6 py-3 transition">
        Morceau suivant ⏭
      </button>
    </div>    

    <audio controls
           class="w-full mb-3"
           data-audio-player-target="audio"
           data-action="ended->audio-player#next">
      <source src="" type="audio/mpeg">
    </audio>
    
    <div class="bg-red-50 p-6 mb-3">
      <p class="text-sm text-red-600 font-medium mb-2">En cours de lecture</p>
      <h2 class="text-2xl font-bold text-purple-900">
        <a href="#" data-audio-player-target="trackTitle" target="_blank" class="hover:text-purple-600">
          -
        </a>
      </h2>
      <p class="text-sm text-purple-600 mt-2 italic">
        <a href="#" data-audio-player-target="albumTitle" target="_blank" class="hover:text-purple-800">
          Album : non renseigné
        </a>
      </p>
      <p class="text-sm text-gray-500 mt-2" data-audio-player-target="trackCounter"></p>
    </div>
    
  </div>
</div>