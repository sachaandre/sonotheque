<p style="color: green"><%= notice %></p>

<div class="bg-white rounded-lg shadow-lg p-8">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-8 gap-4">
    <h1 class="text-3xl font-bold text-purple-800">Albums</h1>
    <%= link_to "Nouvel album", new_album_path, class: "bg-purple-600 hover:bg-purple-700 text-white font-medium px-6 py-3 rounded-lg transition shrink-0" %>
  </div>

  <%= form_with url: albums_path, method: :get, data: { turbo_frame: "_top" } do |f| %>
    <div class="mb-6 flex flex-col sm:flex-row gap-3">
      <%= f.text_field :q,
            value: params[:q],
            placeholder: "Rechercher un album…",
            class: "flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" %>

      <div class="flex items-center gap-2">
        <%= f.number_field :year_from,
              value: params[:year_from],
              placeholder: "De",
              class: "w-24 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-center" %>
        <span class="text-gray-400 text-sm">→</span>
        <%= f.number_field :year_to,
              value: params[:year_to],
              placeholder: "À",
              class: "w-24 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent text-center" %>
      </div>

      <%= f.submit "Filtrer", class: "bg-purple-600 hover:bg-purple-700 text-white font-medium px-5 py-2 rounded-lg transition cursor-pointer" %>
      <% if params[:q].present? || params[:year_from].present? || params[:year_to].present? %>
        <%= link_to "✕", albums_path, class: "px-4 py-2 text-gray-500 hover:text-gray-700 border border-gray-300 rounded-lg transition text-sm" %>
      <% end %>
    </div>
  <% end %>

  <% if @albums.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @albums.each do |album| %>
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-lg transition">
          <h2 class="text-xl font-bold text-purple-800 mb-2">
            <%= link_to album.name, album, class: "hover:text-purple-600" %>
          </h2>
          <p class="text-gray-600 text-sm mb-4"><%= album.year %></p>
          <p class="text-gray-500 text-sm mb-4"><%= album.songs.count %> pistes</p>
          <%= link_to "Voir l'album", album, class: "text-purple-600 hover:text-purple-800 text-sm font-medium" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-400 text-sm italic">Aucun album trouvé.</p>
  <% end %>
</div>