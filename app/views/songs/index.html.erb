<p style="color: green"><%= notice %></p>

<div class="bg-white rounded-lg shadow-lg p-8" data-controller="song-search">
  <div class="w-full flex justify-between items-center mb-8 gap-4">
    <h1 class="text-3xl font-bold text-purple-800">MP3 individuels</h1>
    <%= link_to "Ajouter un MP3", new_song_path, class: "justify-self-end bg-purple-600 hover:bg-purple-700 text-white font-medium px-6 py-3 rounded-lg transition" %>
  </div>

  <!-- Champ de recherche -->
  <div class="flex gap-2 mb-6">
    <input type="text"
           data-song-search-target="input"
           data-action="keydown->song-search#handleKeydown"
           placeholder="Rechercher un titre..."
           class="flex-1 border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-400" />
    <button data-action="click->song-search#search"
            class="bg-purple-600 hover:bg-purple-700 text-white font-medium px-6 py-2 rounded-lg transition">
      Rechercher
    </button>
    <button data-action="click->song-search#reset"
            class="border border-gray-300 hover:bg-gray-100 text-gray-600 font-medium px-4 py-2 rounded-lg transition">
      ✕
    </button>
  </div>

  <% if @songs.any? %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-purple-50 border-b-2 border-purple-200">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-semibold text-purple-800">Titre</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-purple-800">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200" data-song-search-target="results">
          <% @songs.each do |song| %>
            <tr class="hover:bg-purple-50 transition">
              <td class="px-6 py-4">
                <%= link_to song.title, song, class: "text-purple-600 hover:text-purple-800 font-medium" %>
              </td>
              <td class="px-6 py-4">
                <%= link_to "Voir", song, class: "text-purple-600 hover:text-purple-800 text-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex justify-center" data-song-search-target="pagination">
      <%= paginate @songs %>
    </div>
  <% else %>
    <p class="text-gray-600">Aucune chanson</p>
  <% end %>
</div>
